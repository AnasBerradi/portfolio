{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-16",
  "main": "worker.js",
  "assets": { "directory": "." },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      "database_id": "DATABASE_ID_PENDING"
    }
  ]
}
